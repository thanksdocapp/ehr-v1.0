# Copy to `.env.testing` to override phpunit.xml defaults (optional).
# Feature tests run migrations; use MySQL — not SQLite — because many migrations use MySQL-only SQL.
#
# Create database once:
#   CREATE DATABASE ehr_testing CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

APP_ENV=testing
APP_KEY=base64:T3fxRgGnOgrTL0xvH9oUQ/7xyoPqf2WU067rhFXxrxg=

# Main app may still use SQLite in .env.testing; tests force MySQL via tests/TestCase.php.
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_DATABASE=ehr_testing
DB_TEST_USERNAME=root
# Empty for XAMPP default root; set for Docker/CI (see .github/workflows/tests.yml)
DB_TEST_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ehr_testing
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
